# ============================================================
# 环境变量模板（复制成 .env 后填入真实值；.env 已被 .gitignore 忽略）
# 本文件不含任何真实密钥，可安全提交到 GitHub
# ============================================================

# --- 已有：云数据库（IPv4 Session Pooler，不要填 db.xxx 直连） ---
DATABASE_URL=postgresql://postgres.<项目ref>:<密码>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DEEPSEEK_API_KEY=<你的 DeepSeek Key>

# --- 新增：主动陪伴 Cron Job ---
# 自定义一串随机字符串，Web Service 与 Cron Job 必须填同一个值
CRON_SECRET=<例如改成 32 位随机字符串>
BACKEND_URL=https://saki-ai-backend.onrender.com

# --- 新增：Stripe 订阅（$7.99/月） ---
# Stripe Dashboard -> Developers -> API keys（测试用 sk_test_...，正式用 sk_live_...）
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe Dashboard -> Product catalog -> 新建 $7.99/月 递归价格 -> 复制 price_... ID
STRIPE_PRICE_ID=price_xxx
# Stripe Dashboard -> Developers -> Webhooks -> 添加端点后复制 whsec_...
STRIPE_WEBHOOK_SECRET=whsec_xxx
FRONTEND_URL=https://ai-companion-ivory-two.vercel.app

# --- 新增：联网搜索（阶段三：无限求知欲） ---
# https://tavily.com 注册即得免费额度（每月 1000 次），不填则搜索工具自动停用
TAVILY_API_KEY=tvly-xxx

# --- 可选：行为开关 ---
# 是否每轮对话后自动抽取长期记忆（默认 true）
AUTO_EXTRACT_MEMORIES=true
# 免费版记忆条数上限（默认 8，Pro 无限制）
FREE_MEMORY_LIMIT=8
